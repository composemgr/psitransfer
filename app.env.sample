# PSI Transfer — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=psitransfer.example.com
BASE_DOMAIN_NAME=example.com

# Branding
APP_ORG_NAME=PSI Transfer

# Session signing secret
APP_SECRET_KEY=replace-with-a-random-32-character-secret
